# Banco (obrigatório)
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/ponto_sms

# JWT (obrigatório) - gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Necessário apenas para criar o PRIMEIRO administrador (/auth/bootstrap-admin).
# Depois que existir um usuário, pode ser removido.
BOOTSTRAP_TOKEN=

# E-mail (confirmação de cadastro e recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# URL pública do sistema; os links dos e-mails apontam para ela.
FRONTEND_URL=http://localhost:8000

# Origens permitidas no CORS (separadas por vírgula). Se o frontend é servido
# pelo próprio FastAPI, normalmente não precisa mudar.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Pasta dos PDFs enviados (faça backup dela junto com o banco)
UPLOAD_DIR=./uploads

# Content-Security-Policy: report-only (padrão) | enforce | off
CSP_MODE=report-only
